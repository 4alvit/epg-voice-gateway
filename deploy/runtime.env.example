# Copy outside the repository and protect the resulting file with mode 0600.
# kubectl --from-env-file reads these as literal values; do not add shell quotes.
EPG_API_TOKEN=replace-with-a-random-api-token
EPG_ALEXA_SKILL_ID=replace-with-your-skill-id
# Optional: logs only three capability booleans after Amazon verification.
# Stops after 20 requests or ten minutes from startup, whichever comes first.
EPG_ALEXA_CAPABILITY_DIAGNOSTICS=false
EPG_HLS_PROXY_URL=http://hls-proxy.media-services.svc.cluster.local:8080
EPG_PLAYLIST_PATH=/playlist.m3u8
EPG_XMLTV_URLS=["https://guide.example.invalid/xmltv.xml.gz"]
EPG_MEDIA_BASE_URL=https://media.example.invalid
EPG_SIGNING_KEY=replace-with-a-random-signing-key
EPG_TITLE_ALIASES={"kukutiki":["Кукутики"]}
# Optional finite Google voice catalogue. Only currently airing titles appear.
# Channel IDs are an ordered allowlist; [] allows every mapped channel.
# Prefer a short list of channels verified on the intended display.
EPG_VOICE_CHANNEL_IDS=[]
EPG_VOICE_PREFERRED_QUERIES=["Kukutiki"]
EPG_VOICE_CATALOGUE_LIMIT=30
# Limits: 1-50 options, 200 allowed channels, 50 preferred labels. At most 2,000
# current rows are considered in channel-priority/name/ID order. Overlapping
# schedules are excluded. Preferences only rank titles within this bounded set.
# Duplicate titles select the first allowed channel; playback stays pinned to it.
# Separate named-channel voice lineup. [] publishes no channels; list only IDs
# verified on the intended receiver. This does not inherit the programme list.
EPG_CHANNEL_VOICE_MODE=explicit
EPG_CHANNEL_VOICE_IDS=[]
EPG_CHANNEL_VOICE_LIMIT=30
# Optional automatic publication and full-catalogue text search.
# Set mode to automatic to derive the lineup; keep explicit IDs for rollback.
EPG_CHANNEL_ALIASES={"Example International Europe":["Example News"]}
EPG_MEDIA_PREFERRED_CHANNEL_IDS=[]
# Alias maps allow 200 groups and ten aliases per group.
# Full text search covers all imported channels regardless of publication limit.
# 30 is the recommended initial size; the configurable bound is 1-200 channels.
# Names and IDs remain across programme changes. Missing or overlapping current
# EPG entries mark a channel unavailable; stale source snapshots return an error.
# No channel numbers are invented from playlist position or provider IDs.
EPG_REFRESH_SECONDS=300
EPG_MAX_STALE_SECONDS=900
EPG_SESSION_TTL_SECONDS=7200
# The Kubernetes Deployment also sets this explicitly for its writable PVC.
EPG_DATABASE_PATH=/data/catalog.sqlite3

# Optional: enables casting through the existing Home Assistant installation.
# Keys are gateway target names; values are Home Assistant media_player entities.
# EPG_HA_URL=http://home-assistant.home-automation.svc.cluster.local:8123
# EPG_HA_TOKEN=replace-with-your-home-assistant-token
# EPG_HA_TARGETS={"kitchen":"media_player.kitchen_display"}
