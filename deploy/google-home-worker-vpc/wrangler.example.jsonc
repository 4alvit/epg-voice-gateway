{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "home-media-google",
  "main": "relay.mjs",
  "compatibility_date": "2026-09-18",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": {
    "PUBLIC_HOST": "home-media-google.REPLACE_WITH_ACCOUNT_SUBDOMAIN.workers.dev"
  },
  "vpc_services": [
    { "binding": "BACKEND", "service_id": "REPLACE_WITH_EXACT_HA_VPC_SERVICE_ID" }
  ]
}
