{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>victron-venus/venus-os-ci-toolkit:renovate-fleet"
  ],
  "enabledManagers": [
    "github-actions",
    "custom.regex",
    "custom.jsonata",
    "dockerfile",
    "pep621",
    "pip_requirements",
    "terraform",
    "pip-compile"
  ],
  "pip_requirements": {
    "managerFilePatterns": [
      "/(^|/)requirements[^/]*\\.(txt|pip)$/",
      "/^\\.github/requirements-fuzz\\.in$/"
    ],
    "ignorePaths": [
      "**/vendor/**",
      "**/node_modules/**",
      "**/fixtures/**",
      "container/requirements-build.txt",
      "container/requirements-export.txt",
      ".github/requirements-wheels-only.in",
      "container/requirements-build.in",
      "container/requirements-export.in",
      ".github/requirements-fuzz.txt"
    ]
  },
  "ignorePaths": [
    "**/vendor/**",
    "**/node_modules/**",
    "**/fixtures/**",
    ".github/requirements-fuzz.txt"
  ],
  "pip-compile": {
    "managerFilePatterns": [
      "/^container/requirements\\-build\\.txt$/",
      "/^container/requirements\\-export\\.txt$/"
    ]
  },
  "packageRules": [
    {
      "description": "Regenerate coupled exports after the authoritative uv project and lock update.",
      "matchManagers": [
        "pep621"
      ],
      "matchFileNames": [
        "pyproject.toml"
      ],
      "constraints": {
        "uv": "0.13.4"
      },
      "postUpgradeTasks": {
        "commands": [
          "uv export --locked --offline --no-build --no-dev --no-emit-project --format requirements-txt --output-file .renovate-constraints.txt --no-hashes",
          "uv pip compile .github/requirements-fuzz.in --constraint .renovate-constraints.txt --python-version 3.12 --python-platform x86_64-unknown-linux-gnu --no-build --generate-hashes --no-header --no-annotate --output-file .github/requirements-fuzz.txt"
        ],
        "fileFilters": [
          ".github/requirements-fuzz.txt"
        ],
        "executionMode": "update",
        "workingDirTemplate": ".",
        "installTools": {
          "uv": {}
        }
      }
    },
    {
      "description": "Keep fuzz-only dependency changes constrained by the authoritative production uv lock.",
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        ".github/requirements-fuzz.in"
      ],
      "constraints": {
        "uv": "0.13.4"
      },
      "postUpgradeTasks": {
        "commands": [
          "uv export --locked --offline --no-build --no-dev --no-emit-project --format requirements-txt --output-file .renovate-constraints.txt --no-hashes",
          "uv pip compile .github/requirements-fuzz.in --constraint .renovate-constraints.txt --python-version 3.12 --python-platform x86_64-unknown-linux-gnu --no-build --generate-hashes --no-header --no-annotate --output-file .github/requirements-fuzz.txt"
        ],
        "fileFilters": [
          ".github/requirements-fuzz.txt"
        ],
        "executionMode": "update",
        "workingDirTemplate": ".",
        "installTools": {
          "uv": {}
        }
      }
    }
  ]
}
